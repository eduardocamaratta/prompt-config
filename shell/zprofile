# Only RC file loaded on non-interactive zsh shells

# Homebrew
if [ -f /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

# Custom local config
if [ -f $HOME/.config/camaratta-dotfiles/shell/profile ]; then
    source $HOME/.config/camaratta-dotfiles/shell/profile;
fi

# Mise shims directory
if [ -d "$HOME/.local/share/mise/shims" ]; then
    export PATH="$HOME/.local/share/mise/shims:$PATH";
fi
