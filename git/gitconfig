[advice]
	skippedCherryPicks = false
	detachedHead = false
[pull]
	rebase = true
[core]
	excludesFile = ~/.config/camaratta-dotfiles/git/ignore
	editor = code --wait
# Custom local config
[include]
	path = ~/.config/camaratta-dotfiles/git/local
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/